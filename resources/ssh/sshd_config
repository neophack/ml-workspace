# sshd configuration for the ml workspace container.
# Hardened for production: key-based auth preferred, password login still
# enabled (using the VNC_PW-derived ml user password) for ease of access.

# --- Logging -----------------------------------------------------------------
SyslogFacility AUTH
LogLevel INFO

# --- Access control ----------------------------------------------------------
# Only the `ml` user may log in; root login is rejected outright.
AllowUsers ml
PermitRootLogin no
PermitEmptyPasswords no
MaxAuthTries 3
LoginGraceTime 30

# --- Authentication ----------------------------------------------------------
# Both password and public-key auth are accepted. Public key is preferred.
PasswordAuthentication yes
PubkeyAuthentication yes
ChallengeResponseAuthentication no
GSSAPIAuthentication no
IgnoreRhosts yes
HostbasedAuthentication no
IgnoreUserKnownHosts yes
UsePAM no

# Do NOT let the client side pick up a per-user environment file: even a
# whitelist can leak secrets injected via the container environment, and it is
# a known privilege-boundary risk surface. Shells inherit locale from PAM/the
# system instead.
PermitUserEnvironment no

# --- Connection stability ----------------------------------------------------
# Alive intervals make SSH connections more stable behind NAT/proxies.
ClientAliveInterval 60
ClientAliveCountMax 10

# Disallow client-specified bind addresses for remote port forwarding: prevents
# the container from being turned into an internal-network relay/jump host.
GatewayPorts no

# Allow TCP Forwarding: required by vs code remote development:
# https://code.visualstudio.com/docs/remote/troubleshooting#_enabling-alternate-ssh-authentication-methods
AllowTcpForwarding yes

# Allow SSH-Agent Forwarding
AllowAgentForwarding yes

# --- X11 Forwarding (GUI Access) --------------------------------------------
X11Forwarding yes
X11UseLocalhost no
X11DisplayOffset 10

# --- SFTP --------------------------------------------------------------------
Subsystem sftp internal-sftp

# --- Hardening ---------------------------------------------------------------
# Enforce correct ownership/permissions on keyfiles and their directories.
StrictModes yes
